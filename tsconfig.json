{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "baseUrl": ".",
    "paths": {
      "@make-pictures/core": ["packages/core/src/index.ts"],
      "@make-pictures/core/*": ["packages/core/src/*"],
      "@make-pictures/kits": ["packages/kits/src/index.ts"],
      "@make-pictures/kits/*": ["packages/kits/src/*"],
      "@make-pictures/studio": ["packages/studio/src/index.ts"],
      "@make-pictures/studio/*": ["packages/studio/src/*"]
    }
  },
  "include": [
    "packages",
    "examples",
    "productions",
    "src",
    "scripts",
    "remotion.config.ts",
    "vite.config.ts",
    "scenes.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "packages/*/dist",
    "packages/cli/assets"
  ]
}
