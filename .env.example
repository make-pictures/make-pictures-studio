# ============================================================================
# make.pictures — Video-as-Code Studio (Environment Configuration)
# ============================================================================
# Copy this file to `.env.local` and paste your ElevenLabs API key:
#   cp .env.example .env.local
#
# Get your API key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Default multilingual voice ID (optional — individual scenes in `scenes.json` can override `voiceId`)
# Examples:
#   Liam (energetic narrator): TX3LPaxmHKxFdv7VOQHJ
#   Native Polish narrator:    CLuTGacrAhcIhaJslbXt
#   George (warm storyteller): JBFqnCBsd6RMkjVDRZzb
#   Adam (deep narrator):      pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ

# ElevenLabs TTS Model used by `npm run voiceover` (`scripts/generate-voiceover.ts`)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
