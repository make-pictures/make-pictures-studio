{
  "name": "@make-pictures/core",
  "version": "2.0.0",
  "description": "Deterministic 60 FPS Video-as-Code core runtime for make.pictures — Shot DSL cameras (2D/3D), SmartMusicBed auto-ducking, SoundCue word sync, themes, and seeded PRNG.",
  "homepage": "https://make.pictures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/make-pictures/make-pictures-studio.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/make-pictures/make-pictures-studio/issues"
  },
  "author": "make.pictures <pawel@make.pictures>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.mjs",
      "require": "./dist/audio/index.cjs"
    },
    "./camera": {
      "types": "./dist/camera/index.d.ts",
      "import": "./dist/camera/index.mjs",
      "require": "./dist/camera/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.mjs",
      "require": "./dist/theme/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.cjs"
    }
  },
  "peerDependencies": {
    "@react-three/fiber": "^8.0.0 || ^9.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/media-utils": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "remotion": "^4.0.0",
    "three": ">=0.160.0",
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
