{
  "name": "@make-pictures/studio",
  "version": "2.1.1",
  "description": "Local 60 FPS Studio Web UI (<StudioApp />), Zod Props Inspector, Multi-Track Director Timeline, and programmatic Vite studio server for make.pictures.",
  "homepage": "https://make.pictures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/make-pictures/make-pictures-studio.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/make-pictures/make-pictures-studio/issues"
  },
  "author": "make.pictures <pawel@make.pictures>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "keywords": [
    "make-pictures",
    "video-as-code",
    "remotion",
    "studio",
    "player",
    "zod",
    "vite"
  ],
  "peerDependencies": {
    "@make-pictures/core": "^2.1.1",
    "@make-pictures/kits": "^2.1.1",
    "@remotion/player": "^4.0.0",
    "@vitejs/plugin-react": "^4.0.0 || ^5.0.0",
    "lucide-react": "^0.400.0 || ^0.500.0 || >=0.475.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "remotion": "^4.0.0",
    "vite": "^5.0.0 || ^6.0.0",
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "@make-pictures/kits": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
