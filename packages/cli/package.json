{
  "name": "@make-pictures/cli",
  "version": "3.0.0",
  "description": "Production & Audio/QA Toolkit CLI for Remotion + AI Agents — onboarding, ElevenLabs TTS/Dialogue/Music/SFX, asset cutouts, native Contact-Sheet QA, -14 LUFS mastering, and Remotion Elements.",
  "homepage": "https://make.pictures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/make-pictures/make-pictures-studio.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/make-pictures/make-pictures-studio/issues"
  },
  "author": "make.pictures <pawel@make.pictures>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "make-pictures": "dist/bin.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@make-pictures/remotion": "^3.0.0",
    "@remotion/studio-protocol": "^4.0.545",
    "@elevenlabs/elevenlabs-js": "^2.76.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "remotion": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "remotion": {
      "optional": true
    },
    "@remotion/cli": {
      "optional": true
    },
    "@remotion/bundler": {
      "optional": true
    },
    "@remotion/renderer": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "make-pictures",
    "remotion",
    "video-as-code",
    "elevenlabs",
    "60fps",
    "cli"
  ]
}
