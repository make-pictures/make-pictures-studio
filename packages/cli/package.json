{
  "name": "@make-pictures/cli",
  "version": "2.1.0",
  "description": "Unified 60 FPS Video-as-Code CLI for make.pictures — Studio Web launcher, capsule scaffolding, ElevenLabs TTS/Music/SFX pipeline, 12-frame Contact-Sheet QA, and -14 LUFS mastering.",
  "homepage": "https://make.pictures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/make-pictures/make-pictures-studio.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/make-pictures/make-pictures-studio/issues"
  },
  "author": "make.pictures <pawel@make.pictures>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "make-pictures": "dist/bin.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@make-pictures/core": "^2.1.0",
    "@make-pictures/studio": "^2.1.0",
    "@elevenlabs/elevenlabs-js": "^2.76.0",
    "dotenv": "^16.4.7"
  },
  "peerDependencies": {
    "remotion": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "vite": "^5.0.0 || ^6.0.0",
    "@vitejs/plugin-react": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "make-pictures",
    "remotion",
    "video-as-code",
    "elevenlabs",
    "60fps",
    "cli"
  ]
}
